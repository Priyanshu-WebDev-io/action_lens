# Google Gemini API Key (Required for Gemma 4 reasoning core)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# Gemma Model Variant (Default: gemini-2.5-flash or gemma-2-27b-it)
GEMMA_MODEL_NAME="gemini-2.5-flash"

# MinerU Agent API Token (Optional: leave empty if using fallback/no-auth endpoint)
MINERU_API_TOKEN=""
MINERU_API_URL="https://mineru.net/api/v1/extract"
